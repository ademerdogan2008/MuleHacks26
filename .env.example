# Enable Maps JavaScript API in your Google Cloud project.
# Restrict this browser key to your website domains and the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
# Optional production map ID. DEMO_MAP_ID is used for development when omitted.
VITE_GOOGLE_MAPS_MAP_ID=

# Real StungEvents and Mobilize feeds work without API keys.
# Server-only credentials: never prefix these with VITE_.
TICKETMASTER_API_KEY=
# Optional organizer JSON feed for meetups, rallies, parades, and other community events.
COMMUNITY_EVENTS_URL=
